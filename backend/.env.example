OPENROUTER_API_KEY=sk-or-...
GIT_TOKEN=ghp_...
ABUSEIPDB_API_KEY=your_key_here
NVD_API_KEY=your_key_here

# Trivy CVE scanning (Docker Scanner agent)
# Install: backend/scripts/install-trivy.sh
TRIVY_PATH=.bin/trivy
TRIVY_CACHE_DIR=.trivy-cache
TRIVY_WARMUP=true
TRIVY_SKIP_DB_UPDATE=false
TRIVY_SEVERITIES=CRITICAL,HIGH,MEDIUM
TRIVY_MAX_CVES=25
TRIVY_TIMEOUT_SEC=180

# ──────────────────────────────────────────────────────────────
# Service-to-service authentication.
# Must match AGENT_SERVICE_TOKEN in the Vercel web app. 32+ characters.
# Generate with: openssl rand -hex 32
# Fail-closed: while unset, every endpoint except the health check returns 503.
STS_SERVICE_TOKEN=
# Comma-separated browser origins allowed by CORS (defaults to the live site).
STS_ALLOWED_ORIGINS=https://securetotalscan.com
