{
  "name": "securetotalscan",
  "version": "2.0.0",
  "private": true,
  "description": "Secure Total Scan — security for anything exposed to the internet. Free surface scan plus a five-agent deep analysis engine. Next.js web + FastAPI/LangGraph backend.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:scanner": "tsc -p tsconfig.verify.json && node .verify/scripts/verify-scanner.js && npm run verify:input-validation && npm run verify:ratelimit && npm run verify:alerting && npm run verify:findings && npm run verify:target && npm run verify:http-posture && npm run verify:claims && npm run verify:schema && npm run verify:persistence && npm run verify:paywall && npm run verify:report",
    "verify:input-validation": "node .verify/scripts/verify-input-validation.js",
    "verify:ratelimit": "node .verify/scripts/verify-ratelimit.js",
    "verify:alerting": "node .verify/scripts/verify-alerting.js",
    "verify:findings": "node .verify/scripts/verify-findings.js",
    "verify:http-posture": "node .verify/scripts/verify-http-posture.js",
    "verify:target": "node .verify/scripts/verify-target.js",
    "verify:claims": "node .verify/scripts/verify-claims.js",
    "verify:schema": "node .verify/scripts/verify-schema.js",
    "verify:persistence": "node .verify/scripts/verify-persistence.js",
    "verify:paywall": "node .verify/scripts/verify-paywall.js",
    "verify:report": "node .verify/scripts/verify-report.js",
    "migrate": "tsc -p tsconfig.verify.json && node .verify/scripts/migrate.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "^0.35.3",
    "js-yaml": "^4.3.1",
    "brace-expansion": "^5.0.9"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
