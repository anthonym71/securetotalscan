# ──────────────────────────────────────────────────────────────
# Secure Total Scan (web) — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. .env.local is gitignored.
# Backend env vars live in /backend/.env.example
# ──────────────────────────────────────────────────────────────

# Public URL of the agent backend (FastAPI on Railway).
# Local dev default is http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: email the PDF report to the user after a scan.
# Get a key at https://resend.com (free tier available).
RESEND_API_KEY=YOUR_RESEND_API_KEY
REPORT_FROM_EMAIL=reports@securetotalscan.com

# Durable rate limiting via Upstash Redis (REQUIRED in production).
# Serverless instances do not share memory, so production refuses traffic
# (HTTP 503) when these are unset or unreachable — it never falls back to a
# per-instance counter. Local dev without them uses an in-memory window.
# Free tier is sufficient: https://console.upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# Free surface-scan tuning.
SCAN_MAX_BUNDLES=8
SCAN_FETCH_TIMEOUT_MS=8000

# GoHighLevel (LeadConnector) v2 API — powers /api/lead lead capture.
# GHL → Settings → Private Integrations → create a token with contacts.write.
# Server-side only; never exposed to the client.
GHL_API_TOKEN=YOUR_GHL_PRIVATE_INTEGRATION_TOKEN
GHL_LOCATION_ID=YOUR_GHL_LOCATION_ID

# ──────────────────────────────────────────────────────────────
# Dashboard access control (deep-agent features).
# Deny-by-default: with STS_ACCESS_CODES unset, /dashboard and /api/agent
# are closed to everyone. Comma-separated; each entry is `CODE` or `label:CODE`.
STS_ACCESS_CODES=
# Optional: dedicated HMAC key for session cookies. Defaults to a value derived
# from STS_ACCESS_CODES. Rotating either signs everyone out.
STS_AUTH_SECRET=
# Optional hard expiry for all entitlements (ISO date).
STS_ACCESS_EXPIRES=

# Server-side URL of the agent backend. The browser never sees this; requests
# are proxied through /api/agent/* behind authentication.
AGENT_API_URL=http://localhost:8000

# Shared secret proving to the backend that a request came from this proxy.
# Must match STS_SERVICE_TOKEN on the Railway backend, be 32+ characters, and
# never appear in client code, logs or version control.
# Generate with: openssl rand -hex 32
# Fail-closed: without it, /api/agent/* returns 503.
AGENT_SERVICE_TOKEN=
