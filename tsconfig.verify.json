{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": false,
    "outDir": ".verify",
    "types": [
      "node"
    ],
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "lib/alerting.ts",
    "lib/findings.ts",
    "lib/content.ts",
    "lib/brand.ts",
    "lib/ratelimit.ts",
    "lib/scanner/**/*.ts",
    "lib/db/**/*.ts",
    "scripts/migrate.ts",
    "scripts/verify-persistence.ts",
    "scripts/verify-paywall.ts",
    "scripts/verify-report.ts",
    "lib/report/**/*.ts",
    "lib/entitlements.ts",
    "scripts/verify-claims.ts",
    "scripts/verify-schema.ts",
    "scripts/verify-target.ts",
    "scripts/verify-alerting.ts",
    "scripts/verify-findings.ts",
    "scripts/verify-http-posture.ts",
    "scripts/verify-input-validation.ts",
    "scripts/verify-ratelimit.ts",
    "scripts/verify-scanner.ts"
  ]
}
