{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": false,
    "outDir": ".verify",
    "types": [
      "node"
    ],
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "scripts/verify-scanner.ts",
    "scripts/verify-input-validation.ts",
    "lib/scanner/**/*.ts"
  ]
}