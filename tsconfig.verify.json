{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": false,
    "outDir": ".verify",
    // The `@/…` alias from tsconfig.json, repeated here so a file under test
    // can import the way the rest of the codebase does. Without it, anything
    // the verify build compiles has to use relative paths — a rule nothing
    // states and nothing enforces, so it is broken by the next file added.
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ],
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "lib/alerting.ts",
    "lib/findings.ts",
    "lib/content.ts",
    "lib/brand.ts",
    "lib/ratelimit.ts",
    "lib/scanner/**/*.ts",
    "lib/db/**/*.ts",
    "scripts/migrate.ts",
    "scripts/verify-persistence.ts",
    "scripts/verify-claims.ts",
    "scripts/verify-schema.ts",
    "scripts/verify-target.ts",
    "scripts/verify-alerting.ts",
    "scripts/verify-findings.ts",
    "scripts/verify-http-posture.ts",
    "scripts/verify-input-validation.ts",
    "scripts/verify-ratelimit.ts",
    "scripts/verify-scanner.ts"
  ]
}
